FROM apache/airflow:2.9.0-python3.10

USER airflow

RUN pip install --no-cache-dir \
    "openmetadata-ingestion==1.12.5"

RUN pip install --no-cache-dir \
    "openmetadata-managed-apis==1.12.5"

RUN pip install --no-cache-dir \
    "presidio-analyzer==2.2.33" \
    "presidio-anonymizer==2.2.33"

# Pin conflicting packages - must be last and force-reinstalled
RUN pip install --no-cache-dir --force-reinstall \
    "tabulate==0.9.0" \
    "sqlparse==0.5.3" \
    "protobuf==6.30.2"

RUN pip install --no-cache-dir \
    "pymongo" \
    "psycopg2-binary"
